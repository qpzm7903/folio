<?xml version="1.0" encoding="utf-8"?>
<!--
  小尺寸 (1x1, ~160dp): v0.15.4 Issue #6 去掉顶部 "金" 印, 只剩金句主体。
  小尺寸放不下 attribution, 略, 大/中尺寸再显示出处。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/xjk_widget_bg_light">

    <TextView
        android:id="@+id/widget_quote"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:ellipsize="end"
        android:maxLines="5"
        android:lineSpacingMultiplier="1.6"
        android:text="@string/widget_default_quote"
        android:textColor="@color/xjk_fg_1"
        android:textSize="13sp"/>
</LinearLayout>
