lib/generated_plugin_registrant.dart

# Generated (build_runner output — CI 上 `dart run build_runner build` 自动生成)
*.g.dart
*.freezed.dart
*.mocks.dart
*.drift.dart

# flutter gen-l10n 生成的本地化代码 —— CI 上 `flutter pub get` 自动生成
lib/l10n/generated/

# Coverage
coverage/

# 字体文件由 CI 下载，避免巨型二进制入库
assets/fonts/*.ttf
assets/fonts/*.otf
.claude/scheduled_tasks.lock

# L20: ohos 本地构建临时 overrides (模板在 tool/ohos/, 禁止提交根副本)
pubspec_overrides.yaml

# L20: 仓库根 node_modules 是指向 ~/sdks/hvigor/node_modules 的符号链接
# (hvigorfile.ts 解析 @ohos/hvigor-ohos-plugin 用), 禁止入库
/node_modules

# L20: hvigor 直跑产生的根目录缓存
/.hvigor/

# L20: 签名产物 (含设备 UDID + 证书 + 签名 hap), 禁止入库
ohos/.signing/
