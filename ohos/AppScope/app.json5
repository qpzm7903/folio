{
  "app": {
    // 鸿蒙 bundleName schema 要求至少三段 (x.y.z), prompt.md 的 app.folio
    // 两段不合法, 鸿蒙端追加 .ohos 后缀 — 平台强制差异, 见 wiki 02
    "bundleName": "app.folio.ohos",
    "vendor": "folio",
    "versionCode": 53,
    "versionName": "0.17.0",
    "icon": "$media:app_icon",
    "label": "$string:app_name"
  }
}
